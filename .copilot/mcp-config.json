{
  "mcpServers": {
    "notion": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "source": "user"
    },
    "chrome-devtools": {
      "type": "local",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
